# CUDA toolkit installation path — Perlmutter does NOT have /usr/local/cuda.
# CUDA_HOME should always be set by `module load cudatoolkit/12.4` or the
# benchmark runner.  The fallback is CUDA 12.9 from HPC SDK 25.5.
ifndef CUDA_HOME
	CUDA_DIR = /opt/nvidia/hpc_sdk/Linux_x86_64/25.5/cuda/12.9
else
	CUDA_DIR = $(CUDA_HOME)
endif

# Host compiler for nvcc — gcc-14 headers are incompatible with nvcc on
# Perlmutter.  Prefer gcc-13 or gcc-12, falling back to the system default.
NVCC_CCBIN ?= $(shell which gcc-13 2>/dev/null || which gcc-12 2>/dev/null || echo gcc)

# Set SM version via command line argument
SM_VERSION ?= 90

# CUDA toolkit libraries
CUDA_LIB_DIR := $(CUDA_DIR)/lib
ifeq ($(shell uname -m), x86_64)
     ifeq ($(shell if test -d $(CUDA_DIR)/lib64; then echo T; else echo F; fi), T)
     	CUDA_LIB_DIR := $(CUDA_DIR)/lib64
     endif
endif

# CUDA SDK installation path
#SDK_DIR = $(HOME)/NVIDIA_GPU_Computing_SDK/C
SDK_DIR = /usr/local/cuda/samples/
#SDK_DIR =/if10/kw5na/NVIDIA_CUDA_Computing_SDK4/C

